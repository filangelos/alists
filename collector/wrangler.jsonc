{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alists-count",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],

  // Stay on the free plan on purpose. It is the only thing here that turns a
  // sustained flood into a Worker that stops answering rather than an invoice,
  // and it is worth more than any of the checks in the code.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "vars": {
    "SITE_ORIGIN": "https://filangelos.github.io",
    "LISTS_URL": "https://filangelos.github.io/alists/data/lists.json"
    // "DEV_ORIGIN": "http://localhost:8000"  // uncomment to count a local server
  },

  "d1_databases": [
    {
      // `wrangler d1 create` suggests naming the binding after the database.
      // It is `DB` here because that is what src/worker.js reads, and a
      // binding name is a variable name rather than a fact about the database.
      "binding": "DB",
      "database_name": "alists-count",
      "database_id": "0114513b-ec00-42c2-955b-4d1065ad7e22"
    }
  ],

  // Per-location and deliberately approximate, so these bound one loud source
  // rather than a distributed one -- the daily caps in schema.sql are what
  // cover the rest. If your plan rejects this binding, delete the block: the
  // Worker checks for each one and carries on without it.
  //
  // Three ceilings because the three endpoints are three different actions. A
  // page fires a handful of events a minute without trying; a recommendation is
  // typed by hand; and `pass` on the review page is a button anybody who has
  // the URL can press, so it gets the tightest of the three.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "SUGGEST_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "REVIEW_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 }
    }
  ]

  // There is no secret here, and nothing to set. /review is readable by anyone
  // who has the URL: everything on it is a public Maps link plus a sentence
  // somebody chose to send, and the one button it has never deletes anything.
}
